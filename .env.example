# Frontend-only env (Vite exposes VITE_* to the client)
VITE_EMAIL_NOTIFICATIONS=true

# Prefer leaving VITE_API_URL unset:
# - Local: Vite proxies /api → localhost:3001
# - Vercel: vercel.json proxies /api → Render (required for login cookies)
#
# Do NOT set VITE_API_URL in the Vercel dashboard. Cross-origin calls to Render
# break the session cookie → /api/auth/me and /ai-settings return 401.
# VITE_API_URL=https://emp-backend-4wcb.onrender.com
# VITE_API_ALLOW_CROSS_ORIGIN=true
